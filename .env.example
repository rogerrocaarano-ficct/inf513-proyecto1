# Copy to .env. .env is not committed.
# Names and values follow mail-app/src/main/resources/application.properties.
# docker-compose.yml builds DB_URL from DB_NAME and sets the mail hosts and ports to Mailpit.

# PostgreSQL
DB_NAME=mailapp
DB_USER=mailapp
DB_PASSWORD=mailapp

# Address of the system: commands are sent to it and replies come from it
MAIL_ADDRESS=sistema@mailapp.local

# Mailbox read by mail-app through POP3 (Mailpit accepts this user)
POP3_USER=mailapp
POP3_PASSWORD=mailapp

# Polling interval of the mailbox
POLL_INTERVAL=30s

# Initial administrator, created on first startup
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@mailapp.local

# Ports published on the host
POSTGRES_PORT=5432
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
