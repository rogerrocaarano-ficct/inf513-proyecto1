# ReemplazarDocumento(registro): replaces an initial document of a graduation process in progress (UC-003 A2)
# One attachment; its file name says which document it replaces. Run 08-open-graduation-process.http first.
# Sends the command to mail-app through the Mailpit API. The reply arrives after the next poll: see mailbox.http.
@baseUrl = http://localhost:8025
@systemAddress = sistema@mailapp.local
@adminAddress = admin@mailapp.local
@secretaryAddress = secretaria@mailapp.local
@studentAddress = juan.soto@mailapp.local
@registration = 2026101

### Replace the enrollment slip
POST {{baseUrl}}/api/v1/send
Content-Type: application/json

{
  "From": { "Email": "{{secretaryAddress}}" },
  "To": [{ "Email": "{{systemAddress}}" }],
  "Subject": "ReemplazarDocumento({{registration}})",
  "Text": "",
  "Attachments": [
    { "Filename": "Boleta-nueva.pdf", "ContentType": "application/pdf", "Content": "JVBERi0xLjQKJSVFT0YK" }
  ]
}

### Rejected: more than one attachment
POST {{baseUrl}}/api/v1/send
Content-Type: application/json

{
  "From": { "Email": "{{secretaryAddress}}" },
  "To": [{ "Email": "{{systemAddress}}" }],
  "Subject": "ReemplazarDocumento({{registration}})",
  "Text": "",
  "Attachments": [
    { "Filename": "boleta.pdf", "ContentType": "application/pdf", "Content": "JVBERi0xLjQKJSVFT0YK" },
    { "Filename": "carta.pdf", "ContentType": "application/pdf", "Content": "JVBERi0xLjQKJSVFT0YK" }
  ]
}
