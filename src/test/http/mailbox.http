# Mailbox helpers for the Mailpit API: read the replies of mail-app and clear the mailbox.
@baseUrl = http://localhost:8025
@mailbox = admin@mailapp.local

### Last 10 messages received by @mailbox, newest first
GET {{baseUrl}}/api/v1/search?query=to:{{mailbox}}&limit=10

### Delete every message in the mailbox
DELETE {{baseUrl}}/api/v1/messages
